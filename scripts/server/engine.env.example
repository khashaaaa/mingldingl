# The engine's secrets on the home server: /etc/mingldingl/engine.env (root:mingldingl, 640).
# scripts/server/setup.sh copies this file there the first time; fill it in, then ./scripts/deploy.sh.
# systemd reads it: KEY=value, no quotes needed, no $ expansion.

# Postgres on the server itself, over its socket as the mingldingl user (no password).
# The server's Postgres allows 50 connections and zuuchmap shares it: Npgsql's default pool (100)
# opened 65 under load, so it is capped at 20 (also faster: /me +40% req/s). Auto-prepare reuses
# EF's repeated statements.
ConnectionStrings__Default=Host=/var/run/postgresql;Database=mingldingl;Username=mingldingl;Maximum Pool Size=20;Max Auto Prepare=64
# Two different random secrets of 48+ characters. The engine refuses to start if they match.
Auth__SigningKey=replace-with-random-64-chars
Admin__JwtSigningKey=replace-with-a-different-random-64-chars
Admin__Username=admin
# PBKDF2 hash: dotnet run --project src/MinglDingl.Engine -- hash-password '<password>'
Admin__PasswordHash=replace-me
# WeSend live key (ws_live_…): the project must be Active (owner verified by DAN), and each code costs 80 credits.
WeSend__ApiKey=replace-me
# Store reviewers have no Mongolian SIM: this landline is never texted and signs in with this
# six-digit code (Play's Sign in details). Leave both empty to turn it off.
Review__Phone=
Review__Code=
Supabase__ProjectUrl=https://yourproject.supabase.co
Supabase__SecretKey=replace-me
Supabase__PhotoBucket=portraits
# Where the internet reaches the engine (the tunnel's API hostname); deploy.sh builds the web pages
# against it. QPay calls back to the same place. CORS: the panel's origin.
PUBLIC_API_URL=https://api.example.mn
QPay__CallbackBase=https://api.example.mn
Cors__AllowedOrigins=https://keepers.example.mn
# The address the privacy, terms and deletion pages print (and the app's "Write to the keepers").
SUPPORT_EMAIL=keepers@example.mn
# cloudflared runs on the server itself, so loopback (trusted by default) is the only proxy.
ForwardedHeaders__KnownProxies=
ForwardedHeaders__KnownNetworks=
# The Flame Rite (Agora RTC + its Notifications secret). Required while config video.enabled is on.
Agora__AppId=replace-me
Agora__AppCertificate=replace-me
Agora__NcsSecret=replace-me
# QPay merchant (the web page). Empty: the page says payment is not open (nothing can be paid).
# ClientId/ClientSecret are the "Клиент нэр" / "Нууц үг" QPay sent; InvoiceCode is theirs too.
QPay__ClientId=replace-me
QPay__ClientSecret=replace-me
QPay__InvoiceCode=replace-me
QPay__BaseUrl=https://merchant.qpay.mn/v2
# RevenueCat: the secret API key (REST v1) and the Authorization value set on its webhook.
RevenueCat__SecretKey=replace-me
RevenueCat__WebhookAuth=Bearer replace-with-random-32-chars
# Expo push access token (optional; pushes still send without it on the free tier).
Push__ExpoAccessToken=
# Cloudflare tunnel token; `./scripts/deploy.sh --tunnel` starts the tunnel with it.
TUNNEL_TOKEN=
# Optional. Empty = Sentry off.
Sentry__Dsn=
