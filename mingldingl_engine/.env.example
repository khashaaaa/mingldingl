# docker-compose env file: copy to .env and fill in; every variable here is consumed by docker-compose.yml
DATABASE_URL=Host=db;Port=5432;Database=mingldingl;Username=postgres;Password=replace-with-postgres-password
SUPABASE_PROJECT_URL=https://yourproject.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
AGORA_APP_ID=replace-with-agora-app-id
AGORA_APP_CERTIFICATE=replace-with-agora-app-certificate
STORAGE_PUBLIC_BASE_URL=https://api.example.com/uploads
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-output-of-AdminPasswordHasher.Hash
ADMIN_JWT_SIGNING_KEY=replace-with-a-random-64-char-secret
