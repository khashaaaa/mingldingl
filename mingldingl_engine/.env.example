# docker-compose env file: copy to .env and fill in; every variable here is consumed by docker-compose.yml
DATABASE_URL=Host=db;Port=5432;Database=mingldingl;Username=postgres;Password=replace-with-postgres-password
SUPABASE_PROJECT_URL=https://yourproject.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key
# Comma-separated browser origins allowed to call this API. REQUIRED outside Development —
# the engine refuses to start without it rather than falling back to reflecting any origin.
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com

# verify.mn — Mobile-Originated SMS phone verification (https://verify.mn)
# CALLBACK_BASE_URL must be a public https origin this engine serves, or left empty to poll only.
# Never point it at a URL you do not control: verify.mn retries failed callbacks.
VERIFY_MN_API_KEY=replace-with-verify-mn-api-key
VERIFY_MN_BASE_URL=https://api.verify.mn
VERIFY_MN_CALLBACK_BASE_URL=
AGORA_APP_ID=replace-with-agora-app-id
AGORA_APP_CERTIFICATE=replace-with-agora-app-certificate
STORAGE_PUBLIC_BASE_URL=https://api.example.com/uploads
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-output-of-AdminPasswordHasher.Hash
ADMIN_JWT_SIGNING_KEY=replace-with-a-random-64-char-secret
