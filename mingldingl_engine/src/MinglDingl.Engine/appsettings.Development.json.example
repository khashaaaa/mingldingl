{
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=mingldingl;Username=postgres;Password=replace-with-local-postgres-password"
  },
  "Supabase": {
    "ProjectUrl": "https://yourproject.supabase.co",
    "SecretKey": "replace-with-supabase-secret-key"
  },
  "Agora": {
    "AppId": "replace-with-agora-app-id",
    "AppCertificate": "replace-with-agora-app-certificate"
  },
  "Storage": {
    "PublicBaseUrl": "http://localhost:5150/uploads"
  },
  "Admin": {
    "Username": "admin",
    "PasswordHash": "replace-with-output-of-AdminPasswordHasher.Hash",
    "JwtSigningKey": "replace-with-a-random-64-char-secret"
  }
}
