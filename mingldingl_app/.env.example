EXPO_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-anon-key
# Must be this machine's LAN IP (not localhost) — the app bundle bakes this
# in for on-device testing, and the engine must bind 0.0.0.0 to match.
EXPO_PUBLIC_API_URL=http://192.168.1.x:5150
EXPO_PUBLIC_AGORA_APP_ID=your-agora-app-id
# Set to "off" to disable ambient VFX (embers, fog, shimmer); unset or any other value = auto (full / reduced by platform + reduce-motion).
EXPO_PUBLIC_VFX=
