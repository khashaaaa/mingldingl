{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "*.ts",
      "*.js",
      "!src/lib/api/generated",
      "!src/design/figma",
      "!src/design/tokens.ts",
      "!src/design/art/manifest.ts",
      "!src/design/glyphs/index.ts",
      "!expo-env.d.ts"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react-native-svg": "Glyphs are tinted PNG images; live SVG rasterises on the CPU on Android.",
              "@react-navigation/native": "SDK 57: import from expo-router/react-navigation."
            }
          }
        }
      }
    }
  }
}
