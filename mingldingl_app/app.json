{
  "expo": {
    "name": "MingldIngl",
    "slug": "mingldingl",
    "scheme": "mingldingl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.mingldingl.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "MingldIngl needs camera access for video calls with your matches.",
        "NSMicrophoneUsageDescription": "MingldIngl needs microphone access for video calls with your matches."
      }
    },
    "android": {
      "package": "com.mingldingl.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0A0B10"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image-picker",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MingldIngl uses your location to show you nearby matches. It's only read while the app is open, never in the background."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7bff372e-81ab-4e35-b114-503bb9f26e29"
      }
    },
    "owner": "khashaa"
  }
}
